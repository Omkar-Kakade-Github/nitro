{
  "version": 3,
  "configurePresets": [
    {"name": "release", "generator": "Ninja", "binaryDir": "${sourceDir}/build/release", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "NITRO_WARNINGS_AS_ERRORS": "ON"}},
    {"name": "debug", "generator": "Ninja", "binaryDir": "${sourceDir}/build/debug", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "NITRO_WARNINGS_AS_ERRORS": "ON"}},
    {"name": "sanitize", "inherits": "debug", "binaryDir": "${sourceDir}/build/sanitize", "cacheVariables": {"NITRO_SANITIZERS": "ON"}}
  ],
  "buildPresets": [{"name": "release", "configurePreset": "release"}, {"name": "debug", "configurePreset": "debug"}, {"name": "sanitize", "configurePreset": "sanitize"}],
  "testPresets": [{"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}}, {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}}, {"name": "sanitize", "configurePreset": "sanitize", "output": {"outputOnFailure": true}}]
}
